{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // `styles.css` uses Tailwind v4 at-rules (@theme, @custom-variant, @apply)
    // that Biome's CSS parser does not understand — Tailwind owns that file.
    "includes": [
      "**",
      "!src/routeTree.gen.ts",
      "!src/styles.css",
      // Generated by `npm run db:generate` (drizzle-kit). The migration journal
      // and bundled `migrations.js` are committed but not Biome's to format.
      "!drizzle",
      "!dist",
      "!.wrangler"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      // shadcn/ui components are copied registry code. Some registry patterns
      // intentionally use ARIA roles, generated style tags, and index-keyed
      // primitive collections that this template's strict Biome rules flag.
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noRedundantRoles": "off",
            "useAriaPropsForRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noDoubleEquals": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
