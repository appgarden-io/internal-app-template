{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // `styles.css` uses Tailwind v4 at-rules (@theme, @custom-variant, @apply)
    // that Biome's CSS parser does not understand — Tailwind owns that file.
    "includes": [
      "**",
      "!src/routeTree.gen.ts",
      "!src/styles.css",
      // Generated by `npm run db:generate` (drizzle-kit). The migration journal
      // and bundled `migrations.js` are committed but not Biome's to format.
      "!drizzle",
      "!dist",
      "!.wrangler"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      // Nested ternaries and deeply-tangled functions are the two smells that
      // make demo code hard for the next agent to copy correctly. Ban both:
      // rewrite nested ternaries as early returns, and split any function past
      // cognitive-complexity 15 (Biome's own default) into smaller pieces.
      "style": {
        "noNestedTernary": "error",
        // The Cloudflare binding types this App can never have. Bindings in
        // wrangler.jsonc configure LOCAL DEV ONLY — the deploy gateway stamps
        // production bindings itself — so a new one typechecks, builds, passes
        // CI, and is `undefined` in production. Banning the types puts the
        // error on the line that adds it. `scripts/check-bindings.mjs` covers
        // the config side and fails closed on types newer than this list.
        "noRestrictedTypes": {
          "level": "error",
          "options": {
            "types": {
              "KVNamespace": {
                "message": "KV is not available to AppGarden Apps. It works in `npm run dev` and is undefined in production. Use the STORAGE Durable Object, or ask AppGarden (`ask-appgarden-a-question`) before building on it."
              },
              "D1Database": {
                "message": "D1 is not available to AppGarden Apps. It works in `npm run dev` and is undefined in production. Use the STORAGE Durable Object (SQLite) instead."
              },
              "Queue": {
                "message": "Queues are not available to AppGarden Apps. This works in `npm run dev` and is undefined in production. Ask AppGarden (`ask-appgarden-a-question`) before building on it."
              },
              "Hyperdrive": {
                "message": "Hyperdrive is not available to AppGarden Apps. This works in `npm run dev` and is undefined in production. Ask AppGarden (`ask-appgarden-a-question`) before building on it."
              },
              "Vectorize": {
                "message": "Vectorize is not available to AppGarden Apps. This works in `npm run dev` and is undefined in production. Ask AppGarden (`ask-appgarden-a-question`) before building on it."
              },
              "VectorizeIndex": {
                "message": "Vectorize is not available to AppGarden Apps. This works in `npm run dev` and is undefined in production. Ask AppGarden (`ask-appgarden-a-question`) before building on it."
              },
              "AnalyticsEngineDataset": {
                "message": "Analytics Engine is not available to AppGarden Apps. This works in `npm run dev` and is undefined in production. Ask AppGarden (`ask-appgarden-a-question`) before building on it."
              },
              "DispatchNamespace": {
                "message": "Dispatch namespaces are not available to AppGarden Apps — the gateway owns dispatch. Ask AppGarden (`ask-appgarden-a-question`)."
              },
              "SendEmail": {
                "message": "Email sending is not available to AppGarden Apps. This works in `npm run dev` and is undefined in production. Ask AppGarden (`ask-appgarden-a-question`) before building on it."
              },
              "RateLimit": {
                "message": "Rate-limit bindings are not available to AppGarden Apps. This works in `npm run dev` and is undefined in production. Ask AppGarden (`ask-appgarden-a-question`)."
              },
              "Workflow": {
                "message": "Workflows are not available to AppGarden Apps. This works in `npm run dev` and is undefined in production. Ask AppGarden (`ask-appgarden-a-question`) before building on it."
              },
              "ImagesBinding": {
                "message": "The Images binding is not available to AppGarden Apps. This works in `npm run dev` and is undefined in production. Ask AppGarden (`ask-appgarden-a-question`)."
              },
              "SecretsStoreSecret": {
                "message": "Secrets Store is not available to AppGarden Apps. This works in `npm run dev` and is undefined in production. Ask AppGarden (`ask-appgarden-a-question`)."
              }
            }
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      }
    }
  },
  "overrides": [
    {
      // shadcn/ui components are copied registry code. Some registry patterns
      // intentionally use ARIA roles, generated style tags, and index-keyed
      // primitive collections that this template's strict Biome rules flag.
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noRedundantRoles": "off",
            "useAriaPropsForRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "style": {
            "noNestedTernary": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noDoubleEquals": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
