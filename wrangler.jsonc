{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local-dev fallback name only. The deploy gateway names the deployed Worker
  // after this App's registered Slug (the repo name) — never "appgarden-app".
  // Wrangler requires a name here, and `npm run dev` uses it locally.
  "name": "appgarden-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],

  // A single Worker serves both the built Vite SPA assets and the Hono API.
  // The @cloudflare/vite-plugin wires `assets.directory` to the client build
  // output automatically; only the routing behaviour is configured here.
  "assets": {
    "binding": "ASSETS",
    // Unmatched routes fall back to index.html so client-side routing works.
    "not_found_handling": "single-page-application",
    // Requests under /api/* hit the Worker first instead of static assets.
    "run_worker_first": ["/api/*"]
  },

  // Generic SQLite-backed storage Durable Object (demonstrated with notes).
  "durable_objects": {
    "bindings": [
      {
        "name": "STORAGE",
        "class_name": "StorageDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StorageDurableObject"]
    }
  ],

  // Workers AI. Zero provisioning — `env.AI` is always available. App code routes
  // through AI Gateway at call time (`ai.run(model, inputs, { gateway: { id: "default" } })`);
  // the default gateway auto-creates on first request. One AI binding per Worker.
  "ai": {
    "binding": "AI"
  },

  // R2 object storage — one bucket PER App (not shared). `bucket_name` here is a
  // local-dev placeholder: at deploy the gateway creates this App's own bucket
  // (named from its Slug) and stamps the binding server-side — nothing in this
  // file reaches the deployed Worker's bindings. `npm run dev` simulates R2
  // locally, so no real bucket is needed for local development.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "appgarden-app-bucket"
    }
  ],

  // APP_SLUG is this App's slug (its repo name), used for the App's display name
  // (see src/lib/app-name.ts). This local-dev default is replaced at deploy by
  // the gateway, which stamps the registered Slug server-side.
  "vars": {
    "APP_SLUG": "appgarden-app"
  },

  "observability": {
    "enabled": true
  }
}
