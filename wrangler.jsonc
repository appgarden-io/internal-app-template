{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local-dev fallback name only. The Deploy workflow (.github/workflows/deploy.yml)
  // overrides this with the app Slug via `wrangler deploy --name <repo-name>`, so the
  // deployed Worker is named after the repo — never "appgarden-app". Wrangler requires
  // a name here, and `npm run dev` uses it locally.
  "name": "appgarden-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],

  // A single Worker serves both the built Vite SPA assets and the Hono API.
  // The @cloudflare/vite-plugin wires `assets.directory` to the client build
  // output automatically; only the routing behaviour is configured here.
  "assets": {
    "binding": "ASSETS",
    // Unmatched routes fall back to index.html so client-side routing works.
    "not_found_handling": "single-page-application",
    // Requests under /api/* hit the Worker first instead of static assets.
    "run_worker_first": ["/api/*"]
  },

  // Generic SQLite-backed storage Durable Object (demonstrated with notes).
  "durable_objects": {
    "bindings": [
      {
        "name": "STORAGE",
        "class_name": "StorageDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StorageDurableObject"]
    }
  ],

  // Workers AI. Zero provisioning — `env.AI` is always available. App code routes
  // through AI Gateway at call time (`ai.run(model, inputs, { gateway: { id: "default" } })`);
  // the default gateway auto-creates on first request. One AI binding per Worker.
  "ai": {
    "binding": "AI"
  },

  // R2 object storage. All Apps in a Client's Cloudflare account SHARE this one
  // bucket; the Worker namespaces every object under `<APP_SLUG>/` so Apps never
  // collide (see worker/file-store.ts). The bucket is created once per account
  // during Client provisioning (appgarden-deploy runbook, Phase C) — never by the
  // App deploy. The name is a per-account singleton, like the `apps-production`
  // dispatch namespace. `npm run dev` simulates R2 locally, so no real bucket is
  // needed for local development.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "apps-storage"
    }
  ],

  // APP_SLUG is the R2 key prefix that isolates this App inside the shared bucket.
  // This local-dev default is overridden per App at deploy time by the Deploy
  // workflow (`wrangler deploy --var APP_SLUG:<repo-name>`), mirroring how the
  // Worker script name is set from the repo name.
  "vars": {
    "APP_SLUG": "appgarden-app"
  },

  "observability": {
    "enabled": true
  }
}
