{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local-dev fallback name only. The Deploy workflow (.github/workflows/deploy.yml)
  // overrides this with the app Slug via `wrangler deploy --name <repo-name>`, so the
  // deployed Worker is named after the repo — never "appgarden-app". Wrangler requires
  // a name here, and `npm run dev` uses it locally.
  "name": "appgarden-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],

  // A single Worker serves both the built Vite SPA assets and the Hono API.
  // The @cloudflare/vite-plugin wires `assets.directory` to the client build
  // output automatically; only the routing behaviour is configured here.
  "assets": {
    "binding": "ASSETS",
    // Unmatched routes fall back to index.html so client-side routing works.
    "not_found_handling": "single-page-application",
    // Requests under /api/* hit the Worker first instead of static assets.
    "run_worker_first": ["/api/*"]
  },

  // Generic SQLite-backed storage Durable Object (demonstrated with notes).
  "durable_objects": {
    "bindings": [
      {
        "name": "STORAGE",
        "class_name": "StorageDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StorageDurableObject"]
    }
  ],

  // Workers AI. Zero provisioning — `env.AI` is always available. App code routes
  // through AI Gateway at call time (`ai.run(model, inputs, { gateway: { id: "default" } })`);
  // the default gateway auto-creates on first request. One AI binding per Worker.
  "ai": {
    "binding": "AI"
  },

  // R2 object storage — one bucket PER App (not shared). `bucket_name` here is a
  // local-dev placeholder; the Deploy workflow points the binding at this App's
  // own bucket (named after the repo = the Slug) and creates it, mirroring how
  // `name` and `APP_SLUG` are set from the repo at deploy. wrangler has no
  // bucket_name override flag, so the workflow rewrites this value BEFORE the
  // build bakes wrangler.jsonc into dist/. `npm run dev` simulates R2 locally,
  // so no real bucket is needed for local development.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "appgarden-app-bucket"
    }
  ],

  // APP_SLUG is this App's slug (its repo name), used for the App's display name
  // (see src/lib/app-name.ts). This local-dev default is overridden per App at
  // deploy time by the Deploy workflow (`wrangler deploy --var APP_SLUG:<repo>`),
  // mirroring how the Worker script name is set from the repo name.
  "vars": {
    "APP_SLUG": "appgarden-app"
  },

  "observability": {
    "enabled": true
  }
}
